# Step 1: Build
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/node:20-alpine AS builder

WORKDIR /frontend
RUN npm config set registry https://registry.npmmirror.com/

COPY vue3/package*.json ./
RUN npm install
COPY vue3/ .
RUN npm run build 
  # build 出 dist

# Step 2: Serve dist with nginx
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nginx:alpine3.22-slim

COPY --from=builder /frontend/dist /usr/share/nginx/html
  # ⚠️ 这里改成 builder

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

